---
import fs from 'node:fs';
import path from 'node:path';
import ExifReader from 'exifreader';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';

interface PhotoSpecimen {
  filename: string;
  title: string;
  src: string;
  date: string;
  caption: string;
  body: string;
  lens: string;
  exposure: string;
  iso: string;
}

const photoDir = path.join(process.cwd(), 'public', 'photography');
const validExtensions = new Set(['.jpg', '.jpeg', '.png', '.webp', '.avif']);

let photos: PhotoSpecimen[] = [];

if (fs.existsSync(photoDir)) {
  const files = fs.readdirSync(photoDir);
  
  photos = files
    .filter(file => validExtensions.has(path.extname(file).toLowerCase()))
    .map(file => {
      const filePath = path.join(photoDir, file);
      const title = path.parse(file).name.replace(/[-_]/g, ' ');
      
      let body = "Sony ZV-E10";
      let lens = "E PZ 16-50mm F3.5-5.6 OSS II";
      let exposure = "f/5.6 · 1/1000";
      let iso = "ISO 500";
      let date = "2026.04";

      try {
        const fileBuffer = fs.readFileSync(filePath);
        const tags = ExifReader.load(fileBuffer);

        // Camera Body
        if (tags['Model']?.description) {
          body = tags['Model'].description;
        }

        // Lens
        if (tags['LensModel']?.description) {
          lens = tags['LensModel'].description;
        }

        // Aperture & Exposure Time
        const fNumber = tags['FNumber']?.description;
        const exposureTime = tags['ExposureTime']?.description;
        if (fNumber && exposureTime) {
          exposure = `f/${fNumber} · ${exposureTime}`;
        } else if (fNumber) {
          exposure = `f/${fNumber}`;
        } else if (exposureTime) {
          exposure = exposureTime;
        }

        // ISO Sensitivity
        if (tags['ISOSpeedRatings']?.description) {
          iso = `ISO ${tags['ISOSpeedRatings'].description}`;
        }

        // Capture Date
        if (tags['DateTimeOriginal']?.description) {
          const parts = tags['DateTimeOriginal'].description.split(' ')[0].split(':');
          if (parts.length >= 2) {
            date = `${parts[0]}.${parts[1]}`;
          }
        }
      } catch (e) {
        // Safe fallback if EXIF was stripped
      }

      return {
        filename: file,
        title,
        src: `/photography/${encodeURIComponent(file)}`,
        date,
        caption: `Captured on ${body}.`,
        body,
        lens,
        exposure,
        iso,
      };
    });
}
---

<BaseLayout title="Photography">
  <Nav />

  <main class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12 flex-1 w-full space-y-10">
    
    <!-- Section Header -->
    <section class="border-b border-neutral-200 pb-6">
      <div class="flex items-center gap-2 font-mono text-xs text-neutral-400 tracking-widest uppercase mb-2">
        <span class="text-sky-600 font-bold">03.</span>
        <span>Through my Lens</span>
      </div>
      <h1 class="font-serif text-3xl font-normal text-neutral-900 mb-2">Photography</h1>
      <p class="font-serif text-neutral-600 text-base max-w-2xl leading-relaxed">
        Studies in available light, street symmetry, and geometry.
      </p>
    </section>

    <!-- Restored Original Photo Specimen Card Grid -->
    {photos.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
        {photos.map((photo, index) => (
          <article 
            style="background-color: #ffffff;" 
            class="border border-neutral-200 p-5 space-y-4 shadow-[0_1px_3px_rgba(0,0,0,0.02)]"
          >
            <!-- Card Image -->
            <div class="overflow-hidden bg-neutral-900 aspect-[3/2] flex items-center justify-center cursor-pointer group">
              <img 
                src={photo.src} 
                alt={photo.title}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover group-hover:scale-[1.01] transition-transform duration-300 photo-trigger"
                data-index={index}
              />
            </div>

            <!-- Title & Date Line -->
            <div class="flex items-center justify-between border-b border-neutral-100 pb-2">
              <h2 class="font-serif text-xl text-neutral-900 font-normal">{photo.title}</h2>
              <span class="font-mono text-xs text-neutral-400">{photo.date}</span>
            </div>

            <!-- Descriptive Caption Note -->
            <p class="font-serif text-sm text-neutral-600 italic">
              {photo.caption}
            </p>

            <!-- 4-Column Technical Telemetry Spec Sheet on the Card -->
            <div class="grid grid-cols-4 gap-2 pt-3 border-t border-neutral-100 font-mono text-xs">
              <div>
                <span class="text-neutral-400 block text-[9px] uppercase tracking-wider">Body</span>
                <span class="text-neutral-800 text-[11px] block truncate">{photo.body}</span>
              </div>
              <div>
                <span class="text-neutral-400 block text-[9px] uppercase tracking-wider">Lens</span>
                <span class="text-neutral-800 text-[11px] block truncate">{photo.lens}</span>
              </div>
              <div>
                <span class="text-neutral-400 block text-[9px] uppercase tracking-wider">Exposure</span>
                <span class="text-neutral-800 text-[11px] block truncate">{photo.exposure}</span>
              </div>
              <div>
                <span class="text-neutral-400 block text-[9px] uppercase tracking-wider">Sensitivity</span>
                <span class="text-neutral-800 text-[11px] block truncate">{photo.iso}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div style="background-color: #ffffff;" class="p-8 border border-neutral-200 font-mono text-xs text-neutral-400 text-center">
        No images found in public/photography/
      </div>
    )}

  </main>

  <!-- Photo Lightbox Modal: Clean View Without Caption -->
  <dialog 
    id="photo-dialog" 
    class="backdrop:bg-neutral-950/70 p-0 bg-transparent border-0 max-w-4xl w-[92vw] sm:w-[85vw] outline-none my-auto mx-auto"
  >
    <div 
      style="background-color: #ffffff;" 
      class="border border-neutral-200 p-5 sm:p-6 shadow-2xl flex flex-col space-y-4"
    >
      <!-- Top Modal Bar -->
      <div class="flex items-center justify-between border-b border-neutral-200 pb-3 font-mono text-xs">
        <div>
          <span id="modal-title" class="font-semibold text-neutral-900">PLATE INSPECT</span>
        </div>
        <button 
          id="modal-close" 
          type="button"
          aria-label="Close dialog"
          class="text-neutral-400 hover:text-rose-600 p-1 border border-neutral-200 hover:border-rose-200 hover:bg-rose-50/50 transition-colors flex items-center justify-center"
        >
          <svg 
            xmlns="http://www.w3.org/2000/svg" 
            class="w-3.5 h-3.5" 
            viewBox="0 0 24 24" 
            fill="none" 
            stroke="currentColor" 
            stroke-width="2" 
            stroke-linecap="round" 
            stroke-linejoin="round"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Main Preview Image -->
      <div class="w-full bg-neutral-950 max-h-[70vh] flex items-center justify-center overflow-hidden">
        <img 
          id="modal-img" 
          src="" 
          alt="" 
          class="max-w-full max-h-[70vh] object-contain"
        />
      </div>

      <!-- Technical Telemetry Spec Sheet -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 border border-neutral-200 p-3 font-mono text-xs bg-neutral-50/50">
        <div>
          <span class="text-neutral-400 block text-[10px] uppercase">Body</span>
          <span id="modal-body" class="text-neutral-900 font-medium"></span>
        </div>
        <div>
          <span class="text-neutral-400 block text-[10px] uppercase">Lens</span>
          <span id="modal-lens" class="text-neutral-900 font-medium"></span>
        </div>
        <div>
          <span class="text-neutral-400 block text-[10px] uppercase">Exposure</span>
          <span id="modal-exposure" class="text-neutral-900 font-medium"></span>
        </div>
        <div>
          <span class="text-neutral-400 block text-[10px] uppercase">Sensitivity</span>
          <span id="modal-iso" class="text-neutral-900 font-medium"></span>
        </div>
      </div>
    </div>
  </dialog>

  <!-- Client-side Lightbox Logic -->
  <script define:vars={{ photos }}>
    const dialog = document.getElementById('photo-dialog');
    const closeBtn = document.getElementById('modal-close');
    const modalImg = document.getElementById('modal-img');
    const modalTitle = document.getElementById('modal-title');
    const modalBody = document.getElementById('modal-body');
    const modalLens = document.getElementById('modal-lens');
    const modalExposure = document.getElementById('modal-exposure');
    const modalIso = document.getElementById('modal-iso');

    document.querySelectorAll('.photo-trigger').forEach(trigger => {
      trigger.addEventListener('click', () => {
        const index = Number(trigger.getAttribute('data-index'));
        const photo = photos[index];
        if (!photo) return;

        modalImg.src = photo.src;
        modalImg.alt = photo.title;
        modalTitle.textContent = photo.title;
        modalBody.textContent = photo.body;
        modalLens.textContent = photo.lens;
        modalExposure.textContent = photo.exposure;
        modalIso.textContent = photo.iso;

        dialog.showModal();
      });
    });

    closeBtn?.addEventListener('click', () => dialog.close());

    dialog?.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  </script>
</BaseLayout>