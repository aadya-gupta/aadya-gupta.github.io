---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';

const experiments = (await getCollection('lab')).sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);

const renderedExperiments = await Promise.all(
  experiments.map(async (exp) => {
    const { Content } = await render(exp);
    return { ...exp, Content };
  })
);
---

<BaseLayout title="Lab Notebook // Aadya Gupta">
  <Nav />

  <main class="max-w-5xl mx-auto px-6 py-12 flex-1 w-full">
    
    <!-- Page Header -->
    <section class="mb-12 border-b border-neutral-200 pb-8">
      <div class="flex items-center gap-2 font-mono text-xs text-neutral-400 tracking-widest uppercase mb-3">
        <span class="text-sky-600 font-bold">02.</span>
        <span>Laboratory Logs & Empirical Notes</span>
      </div>
      <h1 class="font-serif text-3xl text-neutral-900 font-normal mb-3">Technical Experiments</h1>
      <p class="font-serif text-neutral-600 text-base max-w-2xl leading-relaxed">
        Technical dossiers of mechanistic interpretability runs, sparse autoencoder evaluations, activation patching probes, and circuit discovery. Documenting hypotheses, telemetry, and limitations without full narrative overhead.
      </p>
    </section>

    <!-- Lab Entries Stream -->
    <div class="space-y-10">
      {renderedExperiments.map(({ data, Content }) => {
        const dateStr = new Date(data.date).toISOString().slice(0, 10).replace(/-/g, ".");
        return (
          <article 
            style="background-color: #ffffff;"
            class="border border-neutral-200 p-6 md:p-8 shadow-[0_1px_3px_rgba(0,0,0,0.02)] transition-all hover:border-neutral-300"
          >
            <!-- Card Meta Header -->
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-neutral-200 pb-4 mb-6 font-mono text-xs">
              <div class="flex items-center gap-2">
                <span class="font-semibold text-neutral-900">{data.id_tag}</span>
                <span class="text-neutral-400">//</span>
                <span class="text-sky-600 font-medium">{data.category}</span>
                <span class="text-neutral-400 hidden sm:inline">//</span>
                <span class="text-neutral-400 hidden sm:inline">{dateStr}</span>
              </div>
              <div class="flex items-center gap-2">
                
              </div>
            </div>

            <!-- Experiment Title -->
            <h2 class="font-serif text-2xl font-normal text-neutral-900 mb-6">
              {data.title}
            </h2>

            <!-- Metrics Telemetry Strip (if present) -->
            {data.metrics && (
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-6 p-4 bg-neutral-50/70 border border-neutral-200 font-mono text-xs">
                {Object.entries(data.metrics).map(([key, val]) => (
                  <div>
                    <span class="text-neutral-400 block text-[10px] uppercase tracking-wider">{key}</span>
                    <span class="text-neutral-900 font-semibold">{val}</span>
                  </div>
                ))}
              </div>
            )}

            <!-- Experiment Log Body -->
            <div class="lab-content font-serif text-neutral-800 text-base leading-relaxed space-y-4 prose-h3:font-mono prose-h3:text-xs prose-h3:uppercase prose-h3:tracking-wider prose-h3:text-neutral-400 prose-h3:mt-4 prose-h3:mb-1 prose-ul:font-serif prose-ul:list-disc prose-ul:pl-5 prose-ul:space-y-1">
              <Content />
            </div>

            <!-- Footer: Stack + Link -->
            <div class="flex flex-wrap items-center justify-between gap-4 mt-8 pt-4 border-t border-neutral-200 font-mono text-xs text-neutral-400">
              <div class="flex flex-wrap gap-2">
                {data.stack.map((item) => (
                  <span class="px-2 py-0.5 bg-neutral-100 text-neutral-600 border border-neutral-200 text-[11px]">
                    {item}
                  </span>
                ))}
              </div>
              {data.repo_url && (
                <a
                  href={data.repo_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sky-600 hover:underline inline-flex items-center gap-1"
                >
                  <span>Artifacts & Source</span>
                  <span>↗</span>
                </a>
              )}
            </div>
          </article>
        );
      })}
    </div>

  </main>
</BaseLayout>