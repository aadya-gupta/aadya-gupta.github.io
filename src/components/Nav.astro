---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, "");

const links = [
  { href: "/", label: "Home" },
  { href: "/blog", label: "Blog" },
  { href: "/lab", label: "Lab" },
  { href: "/photography", label: "Photography" },
];

const externalLinks = [
  { href: "/cv.pdf", label: "CV ↗" },
  { href: "https://github.com/aadya-gupta", label: "GitHub ↗" },
];
---

<header class="border-b border-border-subtle bg-canvas/80 backdrop-blur-sm sticky top-0 z-40 transition-colors w-full">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 min-h-[3.5rem] py-2 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 font-mono text-xs">
    
    <!-- Identity Brand -->
    <a href="/" class="flex items-center gap-2 text-ink hover:text-signal-blue transition-colors shrink-0">
      <span class="font-semibold tracking-wider">AADYA GUPTA</span>
    </a>

    <!-- Navigation Links Container -->
    <nav class="flex items-center gap-3 sm:gap-6 overflow-x-auto no-scrollbar py-0.5 max-w-full">
      {links.map((link) => {
        const isActive = currentPath === link.href.replace(/\/$/, "");
        return (
          <a
            href={link.href}
            class:list={[
              "transition-colors shrink-0",
              isActive 
                ? "text-signal-blue font-semibold underline underline-offset-4 decoration-signal-blue" 
                : "text-ink-muted hover:text-ink"
            ]}
          >
            {link.label}
          </a>
        );
      })}

      <!-- Divider -->
      <span class="h-3 w-px bg-border-line shrink-0 hidden sm:inline-block"></span>

      {externalLinks.map((ext) => (
        <a
          href={ext.href}
          target="_blank"
          rel="noopener noreferrer"
          class="text-ink-faint hover:text-ink transition-colors shrink-0"
        >
          {ext.label}
        </a>
      ))}
    </nav>
  </div>
</header>